# Application
APP_ENV=development
LOG_LEVEL=INFO
REQUEST_TIMEOUT_SECONDS=30
MAX_RETRIES=3
MAX_CONCURRENCY=3

# Gemini — verify model availability and quota for your account; limits are not fixed.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
GEMINI_REASONING_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash-lite
GEMINI_RPM_LIMIT=12

# Hermes API server. Keep it on loopback/private networking.
HERMES_API_URL=http://127.0.0.1:8642/v1
HERMES_API_KEY=
HERMES_MODEL_NAME=hermes-agent
# auto: Gemini FAST for QUICK; Hermes for DEEP, when available.
RESEARCH_PLANNER_BACKEND=auto
RESEARCH_RECENT_DAYS=14

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=123456789

# Research sources
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
GITHUB_API_VERSION=2026-03-10
ARXIV_API_URL=https://export.arxiv.org/api/query
ARXIV_MIN_INTERVAL_SECONDS=3
BRAVE_SEARCH_API_KEY=
BRAVE_SEARCH_API_URL=https://api.search.brave.com/res/v1/web/search

# Autonomous digest — public GitHub, arXiv, and these RSS feeds work without Brave.
DIGEST_TOPICS=coding agent efficiency and token optimization,AI agents and agent frameworks,efficient local AI and CPU-only inference,free open-source AI models and tools
DIGEST_SEARCH_QUERIES=coding agent,context optimization,local LLM,open source AI model
DIGEST_NEWS_QUERIES=coding agent token efficiency tools,AI model free tier pricing availability,AI model release launch announcement GPT Gemini
DIGEST_ITEMS_PER_SOURCE=5
DIGEST_MAX_ITEMS=15
DIGEST_REPOSITORY_DAYS=30
DIGEST_PAPER_DAYS=30
DIGEST_NEWS_DAYS=14
DIGEST_MIN_INTERVAL_HOURS=12
DIGEST_STATE_PATH=.data/research-radar.sqlite3
NEWS_FEED_URLS=https://news.google.com/rss/search?q=AI+model+release+when:14d&hl=en-US&gl=US&ceid=US:en,https://openai.com/news/rss.xml,https://deepmind.google/blog/rss.xml,https://research.google/blog/rss/,https://huggingface.co/blog/feed.xml,https://github.blog/feed/,https://blog.cloudflare.com/rss/
